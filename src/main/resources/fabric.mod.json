{
  "schemaVersion": 1,
  "id": "trajectoryplus",
  "version": "${version}",
  "name": "Trajectory+",
  "description": "Client-side 3D trajectory previews for Minecraft projectiles.",
  "environment": "client",
  "license": "MIT",
  "entrypoints": {
    "client": [
      "com.trajectoryplus.TrajectoryPlusClient"
    ],
    "modmenu": [
      "com.trajectoryplus.integration.TrajectoryModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*",
    "modmenu": ">=${modmenu}"
  },
  "mixins": [],
  "icon": "assets/trajectoryplus/icon.png"
}
